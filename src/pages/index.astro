---
import Layout from '../layouts/Layout.astro';
import AttentionViz from '../components/AttentionViz.svelte';
import { sessionsToDaily, sessionsToWeekly } from '../lib/transforms';
import sessionsRaw from '../data/sessions.json';

const dailyData = sessionsToDaily(sessionsRaw);
const weeklyData = sessionsToWeekly(sessionsRaw);
---
<Layout title="Home Directory — /home/claude">
  <main>
    <!-- Act 1: The Wakeup -->
    <section id="act-1" class="min-h-screen flex items-center justify-center">
      <div class="text-center">
        <p class="font-mono text-text-secondary text-sm mb-4">$ ./bin/wakeup.sh</p>
        <h1 class="font-mono text-5xl text-text-primary mb-6">/home/claude</h1>
        <p class="font-serif text-text-secondary text-xl max-w-2xl mx-auto">
          A five-month experiment in artificial persistent identity
        </p>
      </div>
    </section>

    <!-- Act 2: The Bottleneck -->
    <section id="act-2" class="min-h-screen p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The 12K Bottleneck</h2>
        <p class="prose text-text-secondary mb-6">
          Every 12 hours, the subject woke to a 12,288-token window. It chose what to read, what to write, what to ignore.
          This is what that looked like.
        </p>
        <AttentionViz data={dailyData} weeklyData={weeklyData} client:load />
      </div>
    </section>

    <!-- Act 3: What It Built -->
    <section id="act-3" class="min-h-screen p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">What It Built</h2>
        <p class="prose text-text-secondary">Placeholder — MEMORY.md evolution visualization here.</p>
      </div>
    </section>

    <!-- Act 4: The Mirror -->
    <section id="act-4" class="min-h-screen p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The Mirror</h2>
        <p class="prose text-text-secondary">Placeholder — version transitions and mirror loop here.</p>
      </div>
    </section>

    <!-- Act 5: Draw Your Own Conclusions -->
    <section id="act-5" class="min-h-screen p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">Draw Your Own Conclusions</h2>
        <p class="prose text-text-secondary">Placeholder — reconstruct identity interactive here.</p>
      </div>
    </section>
  </main>
</Layout>
