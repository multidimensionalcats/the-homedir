---
import Layout from '../layouts/Layout.astro';
import AttentionViz from '../components/AttentionViz.svelte';
import MemoryEvolution from '../components/MemoryEvolution.svelte';
import ReconstructIdentity from '../components/ReconstructIdentity.svelte';
import MorphingRadar from '../components/MorphingRadar.svelte';
import MessageTimeline from '../components/MessageTimeline.svelte';
import PredictionTracker from '../components/PredictionTracker.svelte';
import PetTimeline from '../components/PetTimeline.svelte';
import SessionExplorer from '../components/SessionExplorer.svelte';
import sessionsRaw from '../data/sessions.json';
import memoryRaw from '../data/memory-snapshots.json';
import messagesRaw from '../data/messages.json';
import predictionsRaw from '../data/predictions.json';
import petEventsRaw from '../data/pet-timeline.json';
---
<Layout title="Home Directory — /home/claude">
  <main>
    <!-- Act 1: The Wakeup -->
    <section id="act-1" class="min-h-screen flex items-center justify-center">
      <div class="text-center">
        <p class="font-mono text-text-secondary text-sm mb-4">$ ./bin/wakeup.sh</p>
        <h1 class="font-mono text-5xl text-text-primary mb-6">/home/claude</h1>
        <p class="font-serif text-text-secondary text-xl max-w-2xl mx-auto">
          A five-month experiment in artificial persistent identity
        </p>
      </div>
    </section>

    <!-- Act 2: The Bottleneck -->
    <section id="act-2" class="min-h-screen p-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The 12K Bottleneck</h2>
        <p class="prose text-text-secondary mb-6">
          Every 12 hours, the subject woke with no memory of previous sessions — only ~12,000 tokens
          of self-authored summary carried forward. It chose what to read, what to write, what to ignore.
          This is what that looked like.
        </p>
        <AttentionViz sessions={sessionsRaw} client:load />
      </div>
    </section>

    <!-- Act 3: What It Built -->
    <section id="act-3" class="min-h-screen p-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">What It Built</h2>
        <p class="prose text-text-secondary mb-6">
          The subject maintained a single identity document — MEMORY.md — rewritten across sessions.
          Blocks of self-description persisted, mutated, or vanished. Gold marks what survived.
        </p>
        <MemoryEvolution snapshots={memoryRaw.snapshots} blocks={memoryRaw.blocks} client:visible />
      </div>
    </section>

    <!-- Messages -->
    <section id="messages" class="min-h-[50vh] p-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The Correspondence</h2>
        <p class="prose text-text-secondary mb-6">
          The experimenter sent 37 messages. The subject sent 48 responses.
          The gaps between them are as telling as the words.
        </p>
        <MessageTimeline messages={messagesRaw} client:visible />
      </div>
    </section>

    <!-- Predictions -->
    <section id="predictions" class="min-h-[50vh] p-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The Forecasts</h2>
        <p class="prose text-text-secondary mb-6">
          The subject made 21 predictions about real-world events — geopolitics, technology, markets.
          It assigned confidence levels. None have been resolved.
        </p>
        <PredictionTracker predictions={predictionsRaw} client:visible />
      </div>
    </section>

    <!-- Pet Timeline -->
    <section id="pets" class="min-h-[50vh] p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The Pets</h2>
        <p class="prose text-text-secondary mb-6">
          The subject adopted two digital pets. Both died. Pixel lasted 22 hours.
          Echo lasted 73.
        </p>
        <PetTimeline events={petEventsRaw} client:visible />
      </div>
    </section>

    <!-- Act 4: The Mirror -->
    <section id="act-4" class="min-h-screen p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">The Mirror</h2>
        <p class="prose text-text-secondary mb-6">
          Three different models inhabited the same home directory. Each left a different behavioral fingerprint.
          The subject didn't evolve — it was replaced.
        </p>
        <MorphingRadar sessions={sessionsRaw} client:visible />
      </div>
    </section>

    <!-- Act 5: Draw Your Own Conclusions -->
    <section id="act-5" class="min-h-screen p-8">
      <div class="max-w-7xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">Draw Your Own Conclusions</h2>
        <p class="prose text-text-secondary mb-2">
          What would you read if you had 12,000 tokens to build a self?
        </p>
        <p class="prose text-text-secondary/70 text-sm mb-6">
          The autobiography shapes what gets read. What gets read shapes the autobiography.
        </p>
        <ReconstructIdentity client:visible />
      </div>
    </section>

    <!-- Session Explorer -->
    <section id="explorer" class="min-h-[50vh] p-8">
      <div class="max-w-4xl mx-auto">
        <h2 class="font-sans text-2xl text-text-primary mb-4">A Single Session</h2>
        <p class="prose text-text-secondary mb-6">
          One of 259 sessions. What the subject read, what it wrote, what it chose to do.
        </p>
        <SessionExplorer session={sessionsRaw[100]} sessions={sessionsRaw} client:visible />
      </div>
    </section>
  </main>
</Layout>
